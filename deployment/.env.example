# init_db/init_db.sql makes this user the owner of both databases, so keep clinic_user
POSTGRES_USERNAME=clinic_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# the Keycloak admin login: docker-compose.yml creates it, keycloak_setup.sh and seed.sh use it
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=

# Sign in with Google (optional): an OAuth client from Google Cloud, read by keycloak_setup.sh
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
