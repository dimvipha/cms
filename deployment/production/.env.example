# Production settings: copy to .env next to compose.yaml, fill in, and keep it private
# (chmod 600 .env; git ignores it). Make each password with: openssl rand -base64 32

# The addresses: two names of your domain pointing at this server, and the web app's address
API_HOST=api.example.com
AUTH_HOST=auth.example.com
WEB_ORIGIN=https://app.example.com
# Let's Encrypt writes here about certificates that are about to expire
ACME_EMAIL=you@example.com

# Postgres, shared by the API and Keycloak
POSTGRES_USER=clinic
POSTGRES_PASSWORD=

# Keycloak's administrator (master realm), made on the first start
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=

# The API's Keycloak client secret: after setup-keycloak.sh, from the admin console,
# realm clinic, Clients, private-app, Credentials
KEYCLOAK_CLIENT_SECRET=

# Where Keycloak sends invites and password resets. For Gmail: smtp.gmail.com, port 587,
# your address as user, and an app password (Google account, Security, App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Printed on prescriptions, invoices and receipts
CLINIC_NAME=CMS Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_TIME_ZONE=Asia/Bangkok
BILLING_CURRENCY=THB
CONSULTATION_FEE=250.00

# Optional: sign in with Google (an OAuth client from Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
